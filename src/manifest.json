{
  "manifest_version": 3,
  "name": "CSBoard - Tool For CS2 Trading",
  "version": "1.1.3",
  "description": "CS2 price comparison, user-confirmed Steam Market tools, and opt-in encrypted portfolio sync.",
  "homepage_url": "https://csboard.com",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CSBOARD settings",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "*://steamcommunity.com/*",
    "*://api.steampowered.com/*",
    "https://csboard.com/*",
    "https://csboard.trade/*",
    "https://csfloat.com/*",
    "https://buff.163.com/*",
    "https://*.buff.163.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://csboard.com/*",
      "https://csboard.trade/*",
      "https://csfolder.com/*"
    ]
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://steamcommunity.com/tradeoffer/*"
      ],
      "js": ["src/content-scripts/steam/trade-offer.ts"],
      "css": ["src/styles/csboard-overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://steamcommunity.com/id/*/inventory*",
        "*://steamcommunity.com/profiles/*/inventory*"
      ],
      "js": ["src/content-scripts/steam/inventory.ts"],
      "css": ["src/styles/csboard-overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://steamcommunity.com/market/listings/730/*"
      ],
      "js": ["src/content-scripts/steam/market.ts"],
      "css": ["src/styles/csboard-overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://steamcommunity.com/*/tradeoffers*"
      ],
      "js": ["src/content-scripts/steam/trade-offers.ts"],
      "css": ["src/styles/csboard-overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://steamcommunity.com/market/search*"
      ],
      "js": ["src/content-scripts/steam/market-search.ts"],
      "css": ["src/styles/csboard-overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://steamcommunity.com/market",
        "*://steamcommunity.com/market/"
      ],
      "js": ["src/content-scripts/steam/market-home.ts"],
      "css": ["src/styles/csboard-overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://steamcommunity.com/*/inventoryhistory*",
        "*://steamcommunity.com/*/tradehistory*"
      ],
      "js": ["src/content-scripts/steam/trade-history.ts"],
      "css": ["src/styles/csboard-overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://steamcommunity.com/id/*",
        "*://steamcommunity.com/profiles/*"
      ],
      "js": ["src/content-scripts/steam/profile.ts"],
      "css": ["src/styles/csboard-overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://steamcommunity.com/*/friends*"
      ],
      "js": ["src/content-scripts/steam/friends.ts"],
      "css": ["src/styles/csboard-overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://csfloat.com/*"
      ],
      "js": ["src/content-scripts/csfloat/csfloat.ts"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://buff.163.com/*",
        "https://*.buff.163.com/*"
      ],
      "js": ["src/content-scripts/buff/buff.ts"],
      "css": ["src/styles/csboard-buff.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injectToPage/inventoryExtractor.js",
        "injectToPage/ShowTradeOffer.js",
        "injectToPage/pageVisitor.js"
      ],
      "matches": [
        "*://steamcommunity.com/*"
      ]
    },
    {
      "resources": [
        "injectToPage/csfloatInterceptor.js",
        "icons/buff163.png",
        "icons/icon128.png"
      ],
      "matches": [
        "https://csfloat.com/*"
      ]
    },
    {
      "resources": [
        "injectToPage/buffInterceptor.js"
      ],
      "matches": [
        "https://buff.163.com/*",
        "https://*.buff.163.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
