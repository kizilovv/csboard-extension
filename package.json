{
  "name": "csboard-extension-prod",
  "version": "1.1.4",
  "description": "CSBOARD trading helper with price overlays, user-confirmed Steam Market tools, and opt-in encrypted portfolio sync.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts test/**/*.test.ts",
    "test:watch": "tsx --test --watch test/*.test.ts test/**/*.test.ts",
    "build": "npm run typecheck && node build.mjs",
    "build:fast": "node build.mjs",
    "build:store": "node scripts/assert-store-config.mjs && npm run build",
    "package:preflight": "node scripts/package-store.mjs --local-preflight",
    "package:store": "node scripts/package-store.mjs --store",
    "audit:capabilities": "node scripts/audit-capabilities.mjs",
    "test:artifact": "node --test test-artifact/**/*.test.mjs",
    "test:e2e:csfloat": "node scripts/e2e-csfloat-metadata-smoke.mjs",
    "test:e2e:buff": "node scripts/e2e-buff-smoke.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.27.4",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@hpke/core": "^1.9.0",
    "@csfloat/cs2-inspect-serializer": "^1.1.6",
    "csgo-fade-percentage-calculator": "^2.0.0"
  }
}
